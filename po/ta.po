msgstr "சத்தமான.."

#: js/blocks/SensorsBlocks.js:262
msgid "The Loudness block returns the volume detected by the microphone."
msgstr "ஒலிப்புத் தொகுதியானது மைக்ரோஃபோன் மூலம் கண்டறியப்பட்ட ஒலியளவை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:317
msgid "click"
msgstr "கிளிக் செய்யவும்"

#: js/blocks/SensorsBlocks.js:323
msgid "The Click block triggers an event if a mouse has been clicked."
msgstr "மவுஸ் கிளிக் செய்யப்பட்டிருந்தால், கிளிக் பிளாக் ஒரு நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:330
msgid "The Click block triggers an event if a turtle has been clicked."
msgstr "ஒரு ஆமை கிளிக் செய்யப்பட்டிருந்தால், கிளிக் பிளாக் ஒரு நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:359
#.TRANS: The mouse cursor is over the mouse icon
msgid "cursor over"
msgstr "கர்சர் முடிந்துவிட்டது"

#: js/blocks/SensorsBlocks.js:364
msgid "The Cursor over block triggers an event when the cursor is moved over a mouse."
msgstr "கர்சர் ஓவர் பிளாக், கர்சரை மவுஸின் மேல் நகர்த்தும்போது நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:373
msgid "The Cursor over block triggers an event when the cursor is moved over a turtle."
msgstr "கர்சர் ஓவர் பிளாக், கர்சரை ஆமையின் மேல் நகர்த்தும்போது ஒரு நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:404
#.TRANS: The cursor is "out" -- it is no longer over the mouse.
msgid "cursor out"
msgstr "கர்சர் வெளியே"

#: js/blocks/SensorsBlocks.js:410
#.TRANS: hover
msgid "The Cursor out block triggers an event when the cursor is moved off of a mouse."
msgstr "சுட்டியிலிருந்து கர்சரை நகர்த்தும்போது கர்சர் அவுட் தொகுதி ஒரு நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:420
#.TRANS: hover
msgid "The Cursor out block triggers an event when the cursor is moved off of a turtle."
msgstr "கர்சர் அவுட் பிளாக் ஒரு ஆமையிலிருந்து கர்சரை நகர்த்தும்போது ஒரு நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:450
msgid "cursor button down"
msgstr "கர்சர் பொத்தான் கீழே"

#: js/blocks/SensorsBlocks.js:455
msgid "The Cursor button down block triggers an event when the cursor button is pressed on a mouse."
msgstr "கர்சர் பட்டன் டவுன் பிளாக், கர்சர் பட்டனை மவுஸில் அழுத்தும் போது நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:464
msgid "The Cursor button down block triggers an event when the cursor button is pressed on a turtle."
msgstr "கர்சர் பட்டன் டவுன் பிளாக் ஒரு ஆமையின் மீது கர்சர் பட்டனை அழுத்தும் போது நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:494
msgid "cursor button up"
msgstr "கர்சர் பொத்தான் மேலே"

#: js/blocks/SensorsBlocks.js:499
msgid "The Cursor button up block triggers an event when the cursor button is released while over a mouse."
msgstr "கர்சர் பொத்தான் அப் பிளாக் ஒரு நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:508
msgid "The Cursor button up block triggers an event when the cursor button is released while over a turtle."
msgstr "கர்சர் பொத்தான் அப் பிளாக் ஆமையின் மேல் இருக்கும் போது கர்சர் பொத்தான் வெளியிடப்படும் போது ஒரு நிகழ்வைத் தூண்டுகிறது."

#: js/blocks/SensorsBlocks.js:590
#: plugins/rodi.rtp:216
msgid "pixel color"
msgstr "பிக்சல் நிறம்"

#: js/blocks/SensorsBlocks.js:595
msgid "The Get pixel block returns the color of the pixel under the mouse."
msgstr "Get pixel block ஆனது மவுஸின் கீழ் உள்ள பிக்சலின் நிறத்தை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:601
msgid "The Get pixel block returns the color of the pixel under the turtle."
msgstr "கெட் பிக்சல் பிளாக் ஆமையின் கீழ் உள்ள பிக்சலின் நிறத்தை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:751
msgid "time"
msgstr "நேரம்"

#: js/blocks/SensorsBlocks.js:758
msgid "The Time block returns the number of seconds that the program has been running."
msgstr "நிரல் இயங்கும் வினாடிகளின் எண்ணிக்கையை டைம் பிளாக் வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:797
msgid "cursor y"
msgstr "கர்சர் மற்றும்"

#: js/blocks/SensorsBlocks.js:802
msgid "The Cursor Y block returns the vertical position of the mouse."
msgstr "கர்சர் ஒய் தொகுதி சுட்டியின் செங்குத்து நிலையை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:838
msgid "cursor x"
msgstr "கர்சர் x"

#: js/blocks/SensorsBlocks.js:843
msgid "The Cursor X block returns the horizontal position of the mouse."
msgstr "கர்சர் எக்ஸ் தொகுதி சுட்டியின் கிடைமட்ட நிலையை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:879
msgid "mouse button"
msgstr "சுட்டி பொத்தான்"

#: js/blocks/SensorsBlocks.js:881
msgid "The Mouse-button block returns True if the mouse button is pressed."
msgstr "மவுஸ் பட்டனை அழுத்தினால், மவுஸ்-பொத்தான் பிளாக் True என்பதை வழங்கும்."

#: js/blocks/SensorsBlocks.js:927
msgid "to ASCII"
msgstr "ASCII க்கு"

#: js/blocks/SensorsBlocks.js:931
msgid "The To ASCII block converts numbers to letters."
msgstr "To ASCII தொகுதி எண்களை எழுத்துகளாக மாற்றுகிறது."

#: js/blocks/SensorsBlocks.js:1002
msgid "The Keyboard block returns computer keyboard input."
msgstr "விசைப்பலகை தொகுதி கணினி விசைப்பலகை உள்ளீட்டை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:1042
msgid "The Get red block returns the red component of the pixel under the mouse."
msgstr "Get red block ஆனது சுட்டியின் கீழ் உள்ள பிக்சலின் சிவப்பு கூறுகளை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:1045
msgid "The Get red block returns the red component of the pixel under the turtle."
msgstr "கெட் ரெட் பிளாக் ஆமையின் கீழ் உள்ள பிக்சலின் சிவப்பு கூறுகளை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:1053
msgid "The Get green block returns the green component of the pixel under the mouse."
msgstr "Get green block ஆனது சுட்டியின் கீழ் உள்ள பிக்சலின் பச்சை கூறுகளை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:1056
msgid "The Get green block returns the green component of the pixel under the turtle."
msgstr "கெட் க்ரீன் பிளாக் ஆமையின் கீழ் உள்ள பிக்சலின் பச்சை கூறுகளை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:1064
msgid "The Get blue block returns the blue component of the pixel under the mouse."
msgstr "கெட் ப்ளூ பிளாக் மவுஸின் கீழ் உள்ள பிக்சலின் நீல கூறுகளை வழங்குகிறது."

#: js/blocks/SensorsBlocks.js:1067
msgid "The Get blue block returns the blue component of the pixel under the turtle."
msgstr "கெட் ப்ளூ பிளாக் ஆமையின் கீழ் உள்ள பிக்சலின் நீல பாகத்தை வழங்குகிறது."

#: js/blocks/ToneBlocks.js:34
#: js/widgets/timbre.js:314
msgid "Oscillator"
msgstr "ஆஸிலேட்டர்"

#: js/blocks/ToneBlocks.js:44
#: js/widgets/TimbrePanels.js:467
#.TRANS: Partials refers to the number of sine waves combined into the sound.
msgid "partials"
msgstr "பகுதிகள்"

#: js/blocks/ToneBlocks.js:76
msgid "You are adding multiple oscillator blocks."
msgstr "நீங்கள் பல ஆஸிலேட்டர் தொகுதிகளைச் சேர்க்கிறீர்கள்."

#: js/blocks/ToneBlocks.js:148
#: js/widgets/TimbrePanels.js:144
#.TRANS: a duo synthesizer combines a synth with a sequencer
msgid "duo synth"
msgstr "இரட்டை சின்த்"

#: js/blocks/ToneBlocks.js:153
msgid "The Duo synth block is a duo-frequency modulator used to define a timbre."
msgstr "டியோ சின்த் பிளாக் என்பது டிம்பரை வரையறுக்கப் பயன்படும் இரட்டை அதிர்வெண் மாடுலேட்டர் ஆகும்."

#: js/blocks/ToneBlocks.js:161
#: js/widgets/TimbrePanels.js:376
msgid "vibrato rate"
msgstr "அதிர்வு விகிதம்"

#: js/blocks/ToneBlocks.js:161
msgid "vibrato intensity"
msgstr "அதிர்வு தீவிரம்"

#: js/blocks/ToneBlocks.js:189
#: js/widgets/TimbrePanels.js:126
#.TRANS: AM (amplitude modulation) synthesizer
msgid "AM synth"
msgstr "AM சின்த்"

#: js/blocks/ToneBlocks.js:193
msgid "The AM synth block is an amplitude modulator used to define a timbre."
msgstr "AM சின்த் பிளாக் என்பது ஒரு டிம்பரை வரையறுக்கப் பயன்படும் அலைவீச்சு மாடுலேட்டர் ஆகும்."

#: js/blocks/ToneBlocks.js:228
#: js/widgets/TimbrePanels.js:135
#.TRANS: FM (frequency modulation) synthesizer
msgid "FM synth"
msgstr "FM சின்த்"

#: js/blocks/ToneBlocks.js:232
msgid "The FM synth block is a frequency modulator used to define a timbre."
msgstr "எஃப்எம் சின்த் பிளாக் என்பது டிம்பரை வரையறுக்கப் பயன்படும் அதிர்வெண் மாடுலேட்டர் ஆகும்."

#: js/blocks/ToneBlocks.js:266
msgid "partial"
msgstr "பகுதி"

#: js/blocks/ToneBlocks.js:269
msgid "The Partial block is used to specify a weight for a specific partial harmonic."
msgstr "ஒரு குறிப்பிட்ட பகுதி ஹார்மோனிக்கிற்கான எடையைக் குறிப்பிட பகுதித் தொகுதி பயன்படுத்தப்படுகிறது."

#: js/blocks/ToneBlocks.js:288
#.TRANS: partials are weighted components in a harmonic series
msgid "Partial weight must be between 0 and 1."
msgstr "பகுதி எடை 0 மற்றும் 1 க்கு இடையில் இருக்க வேண்டும்."

#: js/blocks/ToneBlocks.js:301
#.TRANS: partials are weighted components in a harmonic series
msgid "Partial block should be used inside of a Weighted-partials block."
msgstr "பகுதித் தொகுதியானது எடையுள்ள பகுதிகள் தொகுதியின் உள்ளே பயன்படுத்தப்பட வேண்டும்."

#: js/blocks/ToneBlocks.js:321
msgid "The Weighted partials block is used to specify the partials associated with a timbre."
msgstr "எடையுள்ள பகுதிகள் தொகுதியானது டிம்பருடன் தொடர்புடைய பகுதிகளைக் குறிப்பிடப் பயன்படுகிறது."

#: js/blocks/ToneBlocks.js:329
#.TRANS: partials are weighted components in a harmonic series
msgid "weighted partials"
msgstr "எடையுள்ள பகுதிகள்"

#: js/blocks/ToneBlocks.js:386
msgid "The Harmonic block will add harmonics to the contained notes."
msgstr "ஹார்மோனிக் தொகுதி அடங்கிய குறிப்புகளுக்கு ஹார்மோனிக்ஸ் சேர்க்கும்."

#: js/blocks/ToneBlocks.js:393
#.TRANS: A harmonic is an overtone.
msgid "harmonic"
msgstr "இசைவான"

#: js/blocks/ToneBlocks.js:434
msgid "The Distortion block adds distortion to the pitch."
msgstr "விலகல் தொகுதி சுருதிக்கு சிதைவை சேர்க்கிறது."

#: js/blocks/ToneBlocks.js:441
#.TRANS: distortion is an alteration in the sound
msgid "distortion"
msgstr "திரித்தல்"

#: js/blocks/ToneBlocks.js:491
msgid "The Tremolo block adds a wavering effect."
msgstr "ட்ரெமோலோ பிளாக் ஒரு அலைச்சல் விளைவை சேர்க்கிறது."

#: js/blocks/ToneBlocks.js:493
msgid "Tremolo makes the sound pulse louder and quieter."
msgstr "ட்ரெமோலோ ஒலி துடிப்பை சத்தமாகவும் அமைதியாகவும் செய்கிறது."

#: js/blocks/ToneBlocks.js:495
msgid "The rate (first argument) controls how fast the sound pulses (cycles per second)."
msgstr "விகிதம் (முதல் வாதம்) ஒலி துடிப்புகளை (வினாடிக்கு சுழற்சிகள்) எவ்வளவு வேகமாக கட்டுப்படுத்துகிறது."

#: js/blocks/ToneBlocks.js:499
msgid "The depth (second argument) controls the strength of the pulsing effect (0-100%)."
msgstr "ஆழம் (இரண்டாவது வாதம்) துடிப்பு விளைவின் வலிமையைக் கட்டுப்படுத்துகிறது (0-100%)."

#: js/blocks/ToneBlocks.js:509
#.TRANS: a wavering effect in a musical tone
msgid "tremolo"
msgstr "நடுக்கம்"

#: js/blocks/ToneBlocks.js:514
#: js/blocks/ToneBlocks.js:585
#: js/blocks/ToneBlocks.js:656
#: js/blocks/ToneBlocks.js:725
#: js/widgets/TimbrePanels.js:1170
#: js/widgets/TimbrePanels.js:1261
#: js/widgets/TimbrePanels.js:1393
#: js/widgets/TimbrePanels.js:1515
#.TRANS: rate at which tremolo wavers
msgid "rate"
msgstr "விகிதம்"

#: js/blocks/ToneBlocks.js:516
#: js/blocks/ToneBlocks.js:656
#: js/widgets/TimbrePanels.js:1173
#: js/widgets/TimbrePanels.js:1401
#.TRANS: amplitude of tremolo waver
msgid "depth"
msgstr "ஆழம்"

#: js/blocks/ToneBlocks.js:575
msgid "The Phaser block adds a sweeping sound."
msgstr "பேஸர் பிளாக் ஒரு பெரிய ஒலியை சேர்க்கிறது."

#: js/blocks/ToneBlocks.js:582
#.TRANS: alter the phase of the sound
msgid "phaser"
msgstr "பேஸர்"

#: js/blocks/ToneBlocks.js:585
#: js/turtleactions/IntervalsActions.js:197
#: js/turtleactions/IntervalsActions.js:227
#: js/widgets/TimbrePanels.js:1518
msgid "octaves"
msgstr "எண்மங்கள்"

