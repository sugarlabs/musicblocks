msgstr "स्केलर वर्ग"

#: js/blocks/PitchBlocks.js:468
msgid "nth degree"
msgstr "एनथ डिग्री"

#: js/blocks/PitchBlocks.js:469
msgid "pitch to shade"
msgstr "स्वर को छाया में"

#: js/blocks/PitchBlocks.js:470
