#: js/blocks/GraphicsBlocks.js:432
#: js/blocks/GraphicsBlocks.js:483
#: js/blocks/GraphicsBlocks.js:530
#: js/blocks/GraphicsBlocks.js:761
msgid "y1"
msgstr "yざひょう（ネズミ）"

