{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":gitSignOff"
    ],

    "prBodyNotes": [
        "### PR Category\n- [x] Chore / Refactor\n\n> *This PR was automatically generated by [Renovate Bot](https://docs.renovatebot.com/). It updates one or more dependencies and does not change application logic.*"
    ],

    "forkProcessing": "enabled",

    "npmrc": "legacy-peer-deps=true\nsave-exact=true\npackage-lock=true\nsave=false",
    "npmrcMerge": true,

    "dependencyDashboard": true,
    "dependencyDashboardTitle": "🔄 Renovate Dependency Dashboard",

    "onboarding": false,
    "requireConfig": "optional",

    "timezone": "Asia/Kolkata",

    "schedule": ["before 6am on monday"],

    "labels": ["dependencies", "renovate"],

    "prConcurrentLimit": 5,
    "prHourlyLimit": 2,
    "branchConcurrentLimit": 10,

    "separateMajorMinor": true,
    "separateMinorPatch": false,

    "rebaseWhen": "conflicted",

    "packageRules": [
        {
            "description": "Group all patch and minor devDependency updates together",
            "matchDepTypes": ["devDependencies"],
            "matchUpdateTypes": ["patch", "minor"],
            "groupName": "devDependencies (non-major)",
            "automerge": false,
            "labels": ["dependencies", "renovate", "dev-dependencies"]
        },
        {
            "description": "Group all patch and minor production dependency updates together",
            "matchDepTypes": ["dependencies"],
            "matchUpdateTypes": ["patch", "minor"],
            "groupName": "dependencies (non-major)",
            "automerge": false,
            "labels": ["dependencies", "renovate"]
        },
        {
            "description": "Major updates always get separate PRs with a warning label",
            "matchUpdateTypes": ["major"],
            "labels": ["dependencies", "renovate", "major-update"],
            "automerge": false
        },
        {
            "description": "Pin GitHub Actions to exact digest for security",
            "matchManagers": ["github-actions"],
            "pinDigests": true,
            "groupName": "GitHub Actions",
            "labels": ["dependencies", "renovate", "github-actions"]
        },
        {
            "description": "Electron is pinned – only raise a PR on major bumps",
            "matchPackageNames": ["electron", "electron-builder"],
            "matchUpdateTypes": ["patch", "minor"],
            "enabled": false
        },
        {
            "description": "Stryker packages must stay in sync – group them",
            "matchPackagePatterns": ["^@stryker-mutator/"],
            "groupName": "stryker-mutator packages",
            "labels": ["dependencies", "renovate", "testing"]
        },
        {
            "description": "Cypress – keep together",
            "matchPackageNames": ["cypress"],
            "groupName": "cypress",
            "labels": ["dependencies", "renovate", "testing"]
        },
        {
            "description": "ESLint-related packages – keep together",
            "matchPackagePatterns": ["^eslint", "^@eslint/"],
            "groupName": "eslint packages",
            "labels": ["dependencies", "renovate", "lint"]
        },
        {
            "description": "Babel-related packages – keep together",
            "matchPackagePatterns": ["^@babel/"],
            "groupName": "babel packages",
            "labels": ["dependencies", "renovate"]
        },
        {
            "description": "Gulp plugins – keep together",
            "matchPackagePatterns": ["^gulp"],
            "groupName": "gulp packages",
            "labels": ["dependencies", "renovate"]
        },
        {
            "description": "Tone.js and audio libraries – keep together",
            "matchPackageNames": ["tone", "@tonejs/midi", "howler"],
            "groupName": "audio libraries",
            "labels": ["dependencies", "renovate", "audio"]
        },
        {
            "description": "i18n packages – keep together",
            "matchPackagePatterns": ["^i18next"],
            "groupName": "i18next packages",
            "labels": ["dependencies", "renovate"]
        },
        {
            "description": "commitlint packages – keep together",
            "matchPackagePatterns": ["^@commitlint/"],
            "groupName": "commitlint packages",
            "labels": ["dependencies", "renovate", "lint"]
        }
    ],

    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["dependencies", "renovate", "security"],
        "schedule": ["at any time"],
        "prHourlyLimit": 0,
        "prConcurrentLimit": 0
    },

    "osvVulnerabilityAlerts": true,

    "ignoreDeps": [
        "jquery-ui-dist",
        "materialize-css",
        "ajv"
    ]
}
